{
  "expo": {
    "name": "ريال مايند",
    "slug": "riyal-mind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10B981"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riyalmind.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "نحتاج الكاميرا لمسح الفواتير",
        "NSPhotoLibraryUsageDescription": "نحتاج الوصول للصور لاختيار صور الفواتير",
        "NSFaceIDUsageDescription": "استخدم Face ID لتسجيل الدخول بسرعة",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID"
            ]
          }
        ]
      },
      "usesAppleSignIn": false,
      "config": {
        "googleSignIn": {
          "reservedClientId": "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#10B981"
      },
      "package": "com.riyalmind.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./src/assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "نحتاج الكاميرا لمسح الفواتير"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول للصور لاختيار صور الفواتير"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notification-icon.png",
          "color": "#10B981"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "استخدم Face ID لتسجيل الدخول بسرعة"
        }
      ]
    ],
    "scheme": "riyalmind",
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      },
      "apiUrl": "https://app.riyalmind.com/api",
      "googleClientId": {
        "ios": "YOUR_IOS_CLIENT_ID.apps.googleusercontent.com",
        "android": "YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com",
        "web": "YOUR_WEB_CLIENT_ID.apps.googleusercontent.com"
      }
    },
    "locales": {
      "ar": "./src/locales/ar.json"
    },
    "owner": "riyalmind"
  }
}
